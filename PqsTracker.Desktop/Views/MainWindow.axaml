<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PqsTracker.Desktop.ViewModels"
        xmlns:models="using:PqsTracker.Desktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="PqsTracker.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PQS Tracker">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="PQS Tracker"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <ComboBox Width="200"
                      PlaceholderText="Select trainee"
                      ItemsSource="{Binding Trainees}"
                      SelectedItem="{Binding SelectedTrainee}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TraineeSummaryDto">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox Width="200"
                      PlaceholderText="Select qualification"
                      ItemsSource="{Binding Qualifications}"
                      SelectedItem="{Binding SelectedQualification}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:QualificationSummaryDto">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="Load Progress" Command="{Binding LoadProgressCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <ComboBox Width="200"
                      PlaceholderText="Sign as (qualifier)"
                      ItemsSource="{Binding Trainees}"
                      SelectedItem="{Binding SelectedQualifier}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TraineeSummaryDto">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="Sign Off Selected" Command="{Binding SignOffCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,0,0,8" TextWrapping="Wrap" />

        <!-- DataGridColumn isn't part of the visual tree, so compiled bindings
             can't reach its column definitions — classic bindings here instead. -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding LineItems}"
                  SelectedItem="{Binding SelectedLineItem}"
                  x:CompileBindings="False"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="140" />
                <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="90" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridCheckBoxColumn Header="Required" Binding="{Binding IsRequired}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>

</Window>
